    "services": "node test/service/index.js & sleep 1; node test/service/gated/index.js & sleep 1; node test/service/gated/sibling.js & sleep 1; node test/LogSuite/index.js & wait"
  },
  "eslintConfig": {
    "parser": "@babel/eslint-parser",
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.0",
    "@testing-library/jest-dom": "^5.16.4",
    "chai": "^4.2.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-dropdown-input": "^0.1.11",
    "react-json-view": "^1.21.3",
    "react-markdown": "^8.0.3",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^5.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-test-renderer": "^17.0.2",
    "readline": "^1.3.0",
    "remark-gfm": "^3.0.1",
    "sass": "^1.86.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "author": {
    "name": "Odion Edwards",
    "email": "odionedwards@gmail.com",
    "url": "none"
  },
  "keywords": [
    "SystemView",
    "Odion Edwards"
  ],
  "files": [
    "cli/",
    "api/*.js",
    "build/",
    "testing-utilities",
    "server.js",
    "systemview-plugin/",
    "agents/"
